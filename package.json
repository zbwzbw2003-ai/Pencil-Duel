{
  "name": "pencil-duel-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-public.mjs",
    "predev": "npm run sync-assets",
    "dev": "wrangler dev",
    "predeploy": "npm run sync-assets",
    "deploy": "wrangler deploy",
    "precheck": "npm run sync-assets",
    "check:isolation": "node scripts/verify-isolation.mjs",
    "check": "npm test && npm run check:isolation && wrangler deploy --dry-run --outdir .wrangler-dist",
    "predeploy:production": "npm run check && node scripts/verify-production-branch.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:smoke": "node tests/room-smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.41.0"
  }
}
